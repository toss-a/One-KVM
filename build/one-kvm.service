[Unit]
Description=One-KVM IP-KVM Service
Documentation=https://github.com/mofeng-git/One-KVM
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
Type=simple
User=root
# Example for older Intel GPUs:
# Environment=LIBVA_DRIVER_NAME=i965
# Example for Rockchip legacy VPUs (e.g. RK3399/RK3328/RK3288, auto-detected by default):
# Environment="ONE_KVM_RKMPP_LEGACY_VPU=1"
ExecStart=/usr/bin/one-kvm
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
